# Supabase — from `supabase start` output (local) or your cloud project's
# Project Settings → API page.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Used for signing Storage URLs / privileged reads.
# Never expose to the browser (no NEXT_PUBLIC_ prefix).
SUPABASE_SERVICE_ROLE_KEY=

# Phone OTP needs a live SMS provider + Indian DLT registration. Leave unset
# (or "false") in hosted/prod; local dev uses "true" with config.toml test_otp.
NEXT_PUBLIC_PHONE_OTP_ENABLED=false
